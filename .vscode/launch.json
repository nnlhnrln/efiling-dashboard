{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: server arsip (debug)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/src/index.js",
      "cwd": "${workspaceFolder}/server",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "Frontend: buka Chrome ke localhost:4000",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4000",
      "webRoot": "${workspaceFolder}/client"
    }
  ],
  "compounds": [
    {
      "name": "Arsip: backend + Chrome",
      "configurations": ["Backend: server arsip (debug)", "Frontend: buka Chrome ke localhost:4000"]
    }
  ]
}
